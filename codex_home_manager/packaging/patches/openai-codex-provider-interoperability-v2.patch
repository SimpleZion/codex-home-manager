--- a/codex-rs/protocol/src/response_item_id_tests.rs
+++ b/codex-rs/protocol/src/response_item_id_tests.rs
@@ -51,3 +51,12 @@ fn recognizes_non_empty_prefix_and_suffix() {
         assert_eq!(id.is_prefixed(), expected, "{value}");
     }
 }
+
+#[test]
+fn requires_the_expected_item_type_prefix() {
+    let id = ResponseItemId::from_server("item_foreign".to_string());
+    assert!(id.is_prefixed());
+    assert!(!id.is_prefixed_with("rs"));
+    assert!(!id.is_prefixed_with("msg"));
+    assert!(ResponseItemId::with_suffix("rs", "reasoning").is_prefixed_with("rs"));
+}
