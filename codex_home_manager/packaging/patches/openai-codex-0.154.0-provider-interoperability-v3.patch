diff --git a/codex-rs/protocol/src/response_item_id.rs b/codex-rs/protocol/src/response_item_id.rs
index 9aa66b7..d088e3d 100644
--- a/codex-rs/protocol/src/response_item_id.rs
+++ b/codex-rs/protocol/src/response_item_id.rs
@@ -37,6 +37,11 @@ impl ResponseItemId {
         self.split_once('_')
             .is_some_and(|(prefix, suffix)| !prefix.is_empty() && !suffix.is_empty())
     }
+
+    pub fn is_prefixed_with(&self, expected_prefix: &str) -> bool {
+        self.split_once('_')
+            .is_some_and(|(prefix, suffix)| prefix == expected_prefix && !suffix.is_empty())
+    }
 }
 
 impl Deref for ResponseItemId {
